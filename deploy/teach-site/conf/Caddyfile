# 教程站容器内部用的 Caddy 配置(只在 prismice_app-network 内网监听 80 端口)
# HTTPS 证书由主站网关 prismice-caddy-1 负责,它把 teach.prismice.cn 转发到这里。
{
  admin off
  auto_https off
}

:80 {
  root * /srv

  # VitePress 的"干净网址":/chapters/00-how-to-use → /chapters/00-how-to-use.html
  try_files {path} {path}.html {path}/index.html

  # 带内容哈希的资源可以长期缓存;网页本身每次都检查更新
  @hashed path /assets/*
  header @hashed Cache-Control "public, max-age=31536000, immutable"
  @html path / *.html /chapters/*
  header @html Cache-Control "no-cache"

  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    -Server
  }

  file_server

  handle_errors {
    @404 expression {err.status_code} == 404
    handle @404 {
      rewrite * /404.html
      file_server
    }
  }
}
