# 教程站容器内部用的 Caddy 配置(只在 prismice_app-network 内网监听 80 端口)
# HTTPS 证书由主站网关 prismice-caddy-1 负责,它把 teach.prismice.cn 转发到这里。
{
  admin off
  auto_https off
}

:80 {
  root * /srv

  # 2026-11-17 v0.3:章节按“入门 → 精通”重新排序。旧网址(v0.2)永久跳转到新网址，别人收藏的链接不会失效
  redir /chapters/06-call-api /chapters/23-call-api 301
  redir /chapters/06-call-api.html /chapters/23-call-api 301
  redir /chapters/07-mini-agent /chapters/24-mini-agent 301
  redir /chapters/07-mini-agent.html /chapters/24-mini-agent 301
  redir /chapters/08-install-dsh /chapters/06-install-dsh 301
  redir /chapters/08-install-dsh.html /chapters/06-install-dsh 301
  redir /chapters/09-connect-key /chapters/07-connect-key 301
  redir /chapters/09-connect-key.html /chapters/07-connect-key 301
  redir /chapters/11-automation /chapters/17-automation 301
  redir /chapters/11-automation.html /chapters/17-automation 301
  redir /chapters/12-what-is-skill /chapters/11-what-is-skill 301
  redir /chapters/12-what-is-skill.html /chapters/11-what-is-skill 301
  redir /chapters/13-install-skill /chapters/12-install-skill 301
  redir /chapters/13-install-skill.html /chapters/12-install-skill 301
  redir /chapters/14-ppt-make /chapters/13-ppt-make 301
  redir /chapters/14-ppt-make.html /chapters/13-ppt-make 301
  redir /chapters/15-ppt-polish /chapters/14-ppt-polish 301
  redir /chapters/15-ppt-polish.html /chapters/14-ppt-polish 301
  redir /chapters/16-reliable-search /chapters/15-reliable-search 301
  redir /chapters/16-reliable-search.html /chapters/15-reliable-search 301
  redir /chapters/17-write-skill /chapters/16-write-skill 301
  redir /chapters/17-write-skill.html /chapters/16-write-skill 301
  redir /chapters/21-plugin-dev /chapters/25-plugin-dev 301
  redir /chapters/21-plugin-dev.html /chapters/25-plugin-dev 301
  redir /chapters/22-projects /chapters/21-projects 301
  redir /chapters/22-projects.html /chapters/21-projects 301
  redir /chapters/23-safety-cost /chapters/22-safety-cost 301
  redir /chapters/23-safety-cost.html /chapters/22-safety-cost 301

  # VitePress 的"干净网址":/chapters/00-how-to-use → /chapters/00-how-to-use.html
  try_files {path} {path}.html {path}/index.html

  # 带内容哈希的资源可以长期缓存;网页本身每次都检查更新
  @hashed path /assets/*
  header @hashed Cache-Control "public, max-age=31536000, immutable"
  @html path / *.html /chapters/* /roles/* /skill-hub/*
  header @html Cache-Control "no-cache"

  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    -Server
  }

  # 本站提供下载的 skill 和示例代码：当纯文本显示，浏览器打开就能看到内容（不会变成下载）
  @files {
    path /files/*
    path_regexp \.(md|py)$
  }
  header @files >Content-Type "text/plain; charset=utf-8"

  file_server

  handle_errors {
    @404 expression {err.status_code} == 404
    handle @404 {
      rewrite * /404.html
      file_server
    }
  }
}
